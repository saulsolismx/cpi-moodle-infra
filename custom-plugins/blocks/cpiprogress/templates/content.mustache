{{!
    @template block_cpiprogress/content
    Tarjeta "Aprendizaje" (avance global). Datos reales calculados en Etapa 2.
}}
<div class="cpiprogress-card">
    <h3 class="cpiprogress-title">{{#str}}title, block_cpiprogress{{/str}}</h3>

    <div class="cpiprogress-label">{{#str}}globalprogress, block_cpiprogress{{/str}}</div>
    <div class="cpiprogress-bar" role="progressbar" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100">
        <div class="cpiprogress-bar-fill" style="width: {{progress}}%;"></div>
    </div>

    <div class="cpiprogress-stats">
        <div class="cpiprogress-stat">
            <div class="cpiprogress-label">{{#str}}courses, block_cpiprogress{{/str}}</div>
            <div class="cpiprogress-stat-value">
                <i class="cpiprogress-icon fa fa-check-square" aria-hidden="true"></i>
                <span class="cpiprogress-figure">{{courses}}</span>
            </div>
        </div>
        <div class="cpiprogress-stat">
            <div class="cpiprogress-label">{{#str}}average, block_cpiprogress{{/str}}</div>
            <div class="cpiprogress-stat-value">
                <i class="cpiprogress-icon fa fa-list-alt" aria-hidden="true"></i>
                <span class="cpiprogress-figure">{{average}}</span>
            </div>
        </div>
    </div>
</div>
